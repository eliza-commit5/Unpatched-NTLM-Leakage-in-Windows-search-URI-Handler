// Description: Correlates Windows Search/UNC-based execution activity (search-ms: or \\ paths) with subsequent SMB network connections within a short time window to detect potential phishing-driven file access, malicious shortcut execution, or Windows Search abuse leading to remote share interaction.
// MITRE ATT&CK: T1204.002, T1021.002, T1105
// Data Sources: DeviceProcessEvents, DeviceNetworkEvents
// Threat Actor: Common in phishing campaigns, malware delivery chains, and adversary lateral movement techniques abusing SMB and Windows Explorer; not attributed to a single actor.
// Severity: High
// False Positives: Legitimate user browsing of network shares, enterprise file servers accessed via Explorer, software deployment tools, and scheduled backup or synchronization operations.


DeviceProcessEvents
| where Timestamp > ago(7d)
| where ProcessCommandLine has_any ("search-ms:", "\\\\")
| project
    DeviceId,
    DeviceName,
    UriTime = Timestamp,
    ProcessCommandLine
| join kind=inner hint.strategy=shuffle (
    DeviceNetworkEvents
    | where Timestamp > ago(7d)
    | where RemotePort in (445, 139)
    | project
        DeviceId,
        SMBTime = Timestamp,
        RemoteIP,
        RemotePort
) on DeviceId
| where SMBTime between (UriTime .. UriTime + 5m)
| project
    DeviceName,
    UriTime,
    SMBTime,
    ProcessCommandLine,
    RemoteIP,
    RemotePort
| order by UriTime desc
