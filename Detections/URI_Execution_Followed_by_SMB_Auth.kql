// Description: Correlates Windows Search URI abuse ("search:" / "search-ms:") with breadcrumb-based location manipulation ("crumb=location:") and subsequent SMB network activity (TCP 445/139) within a short time window, which may indicate phishing-driven file access, malicious shortcut execution, or Windows Search-based redirection leading to remote share interaction.
// MITRE ATT&CK: T1204.002, T1021.002, T1105
// Data Sources: DeviceProcessEvents, DeviceNetworkEvents
// Threat Actor: Common in phishing campaigns, malware delivery chains, and adversary tradecraft abusing Windows Search and SMB-based payload delivery; not attributed to a single actor.
// Severity: High
// False Positives: Legitimate enterprise use of Windows Search to access internal file shares, mapped drives, software distribution shares, and user-initiated browsing of network resources.

DeviceProcessEvents
| where Timestamp > ago(7d)
| where ProcessCommandLine has_any ("search:", "search-ms:")
| where ProcessCommandLine has "crumb=location:"
| project
    DeviceId,
    DeviceName,
    AccountName = InitiatingProcessAccountName,
    UriTime = Timestamp,
    ProcessCommandLine
| join kind=inner (
    DeviceNetworkEvents
    | where Timestamp > ago(7d)
    | where RemotePort in (445, 139)
    | project
        DeviceId,
        SMBTime = Timestamp,
        RemoteIP,
        RemotePort
) on DeviceId
| where SMBTime between (UriTime .. UriTime + 5m)
| project
    DeviceName,
    AccountName,
    UriTime,
    SMBTime,
    RemoteIP,
    RemotePort,
    ProcessCommandLine
| order by UriTime desc
